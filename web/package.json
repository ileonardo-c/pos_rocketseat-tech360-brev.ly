{
  "name": "web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --config-path ../biome.json --files-ignore-unknown=true src",
    "format": "biome format --config-path ../biome.json --write --files-ignore-unknown=true src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "e2e": "cross-env E2E_BASE_URL=http://localhost:5173 playwright test e2e/smoke.spec.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:proof": "cross-env E2E_PROOF=1 E2E_BASE_URL=http://localhost:5173 playwright test e2e/smoke.spec.ts",
    "e2e:visual": "cross-env PW_VISUAL=1 E2E_BASE_URL=http://127.0.0.1:4173 playwright test e2e/visual-regression.spec.ts",
    "e2e:visual:update": "cross-env PW_VISUAL=1 E2E_BASE_URL=http://127.0.0.1:4173 playwright test e2e/visual-regression.spec.ts -u"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.13.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.66.1",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
