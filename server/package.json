{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/infra/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/infra/http/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint not configured\"",
    "format": "echo \"format not configured\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "pulumi:preview": "pulumi preview --cwd infra",
    "pulumi:up": "pulumi up --cwd infra"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@supabase/supabase-js": "^2.58.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
